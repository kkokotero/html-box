{
	"name": "html-box",
	"version": "0.3.3",
	"private": false,
	"description": "Expressive JavaScript and TypeScript utilities for working with the DOM",
	"keywords": [
		"dom",
		"dom-query",
		"events",
		"gestures",
		"html",
		"interaction",
		"keyboard",
		"query",
		"typescript"
	],
	"homepage": "https://github.com/kkokotero/html-tools#readme",
	"bugs": {
		"url": "https://github.com/kkokotero/html-box/issues"
	},
	"license": "MIT",
	"author": {
		"name": "kkoko",
		"email": "is.kkokotero@gmail.com",
		"url": "https://github.com/kkokotero"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kkokotero/html-box.git"
	},
	"files": [
		"dist",
		"misc",
		"LICENSE",
		"README.md"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		"./query": {
			"types": "./dist/query/index.d.ts",
			"default": "./dist/query/index.js"
		},
		"./interaction": {
			"types": "./dist/interaction/index.d.ts",
			"default": "./dist/interaction/index.js"
		},
		"./pointer": {
			"types": "./dist/pointer/index.d.ts",
			"default": "./dist/pointer/index.js"
		},
		"./html": {
			"types": "./dist/html/index.d.ts",
			"default": "./dist/html/index.js"
		},
		"./safe-zone": {
			"types": "./dist/safe-zone/index.d.ts",
			"default": "./dist/safe-zone/index.js"
		},
		"./viewport": {
			"types": "./dist/viewport/index.d.ts",
			"default": "./dist/viewport/index.js"
		},
		"./keyboard": {
			"types": "./dist/keyboard/index.d.ts",
			"default": "./dist/keyboard/index.js"
		},
		"./scheduler": {
			"types": "./dist/scheduler.d.ts",
			"default": "./dist/scheduler.js"
		},
		"./element": {
			"types": "./dist/element/index.d.ts",
			"default": "./dist/element/index.js"
		},
		"./form": {
			"types": "./dist/form/index.d.ts",
			"default": "./dist/form/index.js"
		},
		"./view-transition": {
			"types": "./dist/view-transition/index.d.ts",
			"default": "./dist/view-transition/index.js"
		},
		"./reactive": {
			"types": "./dist/reactive/index.d.ts",
			"default": "./dist/reactive/index.js"
		},
		"./browser": {
			"types": "./dist/browser/index.d.ts",
			"default": "./dist/browser/index.js"
		}
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "oxlint .",
		"lint:fix": "oxlint --fix .",
		"format": "oxfmt .",
		"format:check": "oxfmt --check .",
		"check": "npm run typecheck && npm run lint && npm run format:check"
	},
	"devDependencies": {
		"@types/node": "^22.15.0",
		"jsdom": "^26.1.0",
		"oxfmt": "^0.75.0",
		"oxlint": "^1.90.0",
		"tsdown": "^0.23.4",
		"typescript": "^7.0.2",
		"vitest": "^3.2.7"
	},
	"engines": {
		"node": ">=18"
	}
}
