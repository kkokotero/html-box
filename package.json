{
	"name": "html-tools",
	"version": "0.1.0",
	"private": false,
	"description": "Expressive JavaScript and TypeScript utilities for working with the DOM",
	"keywords": [
		"dom",
		"dom-query",
		"events",
		"gestures",
		"html",
		"interaction",
		"query",
		"typescript"
	],
	"homepage": "https://github.com/kkokotero/html-tools#readme",
	"bugs": {
		"url": "https://github.com/kkokotero/html-tools/issues"
	},
	"license": "MIT",
	"author": {
		"name": "kkoko",
		"email": "is.kkokotero@gmail.com",
		"url": "https://github.com/kkokotero"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kkokotero/html-tools.git"
	},
	"files": [
		"dist",
		"misc",
		"LICENSE",
		"README.md"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		"./query": {
			"types": "./dist/query.d.ts",
			"default": "./dist/query.js"
		},
		"./interaction": {
			"types": "./dist/interaction.d.ts",
			"default": "./dist/interaction.js"
		},
		"./pointer": {
			"types": "./dist/pointer.d.ts",
			"default": "./dist/pointer.js"
		},
		"./html": {
			"types": "./dist/html.d.ts",
			"default": "./dist/html.js"
		},
		"./safe-zone": {
			"types": "./dist/safe-zone.d.ts",
			"default": "./dist/safe-zone.js"
		}
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "oxlint .",
		"lint:fix": "oxlint --fix .",
		"format": "oxfmt .",
		"format:check": "oxfmt --check .",
		"check": "npm run typecheck && npm run lint && npm run format:check"
	},
	"devDependencies": {
		"@types/node": "^22.15.0",
		"jsdom": "^26.1.0",
		"oxfmt": "^0.75.0",
		"oxlint": "^1.90.0",
		"tsdown": "^0.23.4",
		"typescript": "^7.0.2",
		"vitest": "^3.2.7"
	},
	"engines": {
		"node": ">=18"
	}
}
